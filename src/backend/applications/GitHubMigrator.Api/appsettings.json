{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "GitHubMigrator",
    "Audience": "GitHubMigrator.Web"
  },
  "Storage": {
    "Container": "migration-artifacts"
  },
  "Observability": {
    "Provider": "Otlp"
  },
  "Frontend": {
    "Origin": "http://localhost:5173"
  }
}
