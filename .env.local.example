# Copy to .env.local (gitignored). Replace values as needed.
COMPOSE_PROJECT_NAME=githubmigrator
HOST_BIND_ADDRESS=127.0.0.1
PUBLIC_HOSTNAME=localhost
FRONTEND_PORT=5173
API_PORT=8080
POSTGRES_PORT=5432
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
POSTGRES_DB=githubmigrator
POSTGRES_USER=githubmigrator
POSTGRES_PASSWORD=local-change-me
BOOTSTRAP_USERNAME=superadmin
BOOTSTRAP_PASSWORD=superadmin
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters-for-local-use
GRAFANA_ADMIN_PASSWORD=admin
# Generated automatically on first launch by dev.sh / dev.ps1; do not commit the result.
LOCAL_ENCRYPTION_KEY=GENERATE_ON_FIRST_RUN

# Azure DevOps Server simulator (docker compose up) and optional Windows VM (dev ado-server)
ADO_SIM_PAT=sim-pat
ADO_SIM_PORT=8081
ADO_SERVER_ADMIN_USER=labadmin
ADO_SERVER_ADMIN_PASSWORD=LabAdmin#2026

# ado-sim flavour: `server` (Azure DevOps Server, /tfs) or `services` (stand-in for dev.azure.com + vssps).
# `dev lab-services` sets the flavour and the API's Services roots; leave these empty for Microsoft's cloud.
ADO_SIM_FLAVOR=server
ADO_SERVICES_CORE_ROOT=
ADO_SERVICES_GRAPH_ROOT=
ADO_SERVICES_GIT_ROOT=
ADO_SERVICES_ALLOWED_HOSTS=

# GitHub Enterprise Server-shaped simulator (docker compose up). The API targets it only for `dev lab`
# (or when you set these three): leave them empty to talk to github.com.
GH_SIM_PORT=8083

# OpenAI-compatible LLM simulator (docker compose up). An AI connection reaches it only when its host is allowed:
# `dev lab` sets AI_ALLOWED_HOSTS=llm-sim; leave it empty for the default (Azure OpenAI hosts only).
LLM_SIM_PORT=8084
AI_ALLOWED_HOSTS=
# Four eyes on AI-converted workflows: the person who asked for a conversion cannot approve it. Set to false only for a
# single-reviewer sandbox (the approver is recorded either way).
WORKFLOW_APPROVAL_REQUIRE_SECOND_APPROVER=true
GITHUB_API_ROOT=
GITHUB_WEB_ROOT=
GITHUB_ALLOWED_HOSTS=
