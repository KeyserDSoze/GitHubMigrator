terraform {
  required_version = ">= 1.9.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # Add an encrypted, access-controlled remote backend before real use.
}

provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}
