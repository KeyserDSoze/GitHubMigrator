<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LlmSim</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="seed\**" />
    <None Remove="seed\**" />
    <EmbeddedResource Include="seed\**" LogicalName="seed/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
